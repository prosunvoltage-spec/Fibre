# ─────────────────────────────────────────────────────────────────────────────
# VRA-NVT-Automation — Beispiel-Konfiguration
# Kopiere diese Datei zu ".env" und passe die Werte an.
# .env darf niemals ins Git commited werden (siehe .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# --- Datenbank ------------------------------------------------------------
# Lokal (Default): SQLite unter data/dev.db
DATABASE_URL=sqlite:///./data/dev.db
# Produktion: PostgreSQL
# DATABASE_URL=postgresql+psycopg://vra:vra@localhost:5432/vra

# --- Vision-Provider ------------------------------------------------------
VISION_PROVIDER=anthropic
VISION_MODEL=claude-opus-4-7
# Nur pflichtig, wenn VISION_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Wie viele parallele Vision-Aufrufe max. — Rate-Limit-Schutz
VISION_MAX_CONCURRENCY=4

# --- OCR-Provider ---------------------------------------------------------
OCR_PROVIDER=tesseract
# Pfad zum Tesseract-Binary (optional; nur setzen, wenn nicht im PATH)
TESSERACT_CMD=

# --- Geo-Provider (optional) ---------------------------------------------
GEO_PROVIDER=nominatim
# Nominatim braucht einen User-Agent (Netiquette)
NOMINATIM_USER_AGENT=vra-nvt-automation/0.1 (contact@example.com)

# --- Storage --------------------------------------------------------------
STORAGE_PATH=./data
KNOWLEDGE_PATH=./knowledge
PROMPTS_PATH=./prompts

# --- API ------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Für Produktion mind. 32 zufällige Bytes (openssl rand -hex 32)
SECRET_KEY=change-me-development-only

# --- Freigabe / Review ---------------------------------------------------
# Vier-Augen-Prinzip pro Projekt aktivierbar (Phase 12)
REQUIRE_SECOND_REVIEW=false

# --- Schwellwerte Rule Engine --------------------------------------------
# 0..1; siehe docs/RULE_ENGINE.md §7
RULE_AUTO_APPROVE_RULE_CONF=0.9
RULE_AUTO_APPROVE_COMPLETENESS=0.9
RULE_CRITICAL_COMPLETENESS=0.5
RULE_TIE_THRESHOLD=0.05

# --- Regelwerks-Version --------------------------------------------------
# Wird pro Projekt eingefroren; alte Projekte behalten ihre Version
CURRENT_RULESET_VERSION=v1
